@using Campus_Chat
@using Campus_Chat.Models

<div class="cc-post">
    <span class="cc-avatar"
          style="background:@UiHelpers.AvatarBackground(AvatarColour)"
          aria-hidden="true">
        @UiHelpers.Initials(AuthorName)
    </span>

    <div class="cc-post-body">
        <div class="cc-post-heading">
            <a class="cc-post-name" href="/profile/@Post.AuthorId">
                @AuthorName
            </a>

            <time class="cc-post-time">
                @Post.Time.LocalDateTime.ToString("g")
            </time>
        </div>

        <div class="cc-post-text">@Post.Text</div>

        <div class="cc-post-actions">
            @if (CanReply)
            {
                <button @onclick="() => OnReply.InvokeAsync(Post.Id)">
                    ↩ Reply
                </button>
            }

            @if (CanDelete)
            {
                <button class="danger"
                        @onclick="() => OnDelete.InvokeAsync(Post.Id)">
                    Delete
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required Post Post { get; set; }
    [Parameter] public string AuthorName { get; set; } = "Unknown user";
    [Parameter] public string? AvatarColour { get; set; }
    [Parameter] public bool CanReply { get; set; } = true;
    [Parameter] public bool CanDelete { get; set; }

    [Parameter] public EventCallback<Guid> OnReply { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
}