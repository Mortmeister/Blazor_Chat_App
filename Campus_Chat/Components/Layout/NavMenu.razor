@implements IDisposable
@using Campus_Chat
@using Campus_Chat.Models
@inject Campus_Chat.Services.CurrentUserService CurrentUser
@inject Campus_Chat.Services.ChatService Chat
@inject NavigationManager NV

<aside class="cc-sidebar">
    <a class="cc-brand" href="">
        <span class="cc-brand-mark">💬</span>
        <span>Campus Chat</span>
    </a>

    <nav class="cc-nav">
        <p class="cc-nav-label">Workspace</p>

        <NavLink class="cc-nav-item" href="threads" Match="NavLinkMatch.Prefix">
            <span class="cc-nav-icon">#</span> Threads
            @if (totalUnread > 0)
            {
                <span class="cc-pill">@totalUnread</span>
            }
        </NavLink>

        @if (CurrentUser.User is not null)
        {
            <NavLink class="cc-nav-item" href="chats" Match="NavLinkMatch.Prefix">
                <span class="cc-nav-icon">💬</span> Messages
            </NavLink>
            <NavLink class="cc-nav-item" href="people" Match="NavLinkMatch.Prefix">
                <span class="cc-nav-icon">👥</span> People
            </NavLink>
        }
    </nav>

    <div class="cc-usercard">
        @if (CurrentUser.User is { } me)
        {
            <a class="cc-usercard-link" href="/profile/@me.Id">
                <span class="cc-avatar cc-avatar-sm" style="background:@UiHelpers.AvatarBackground(me.AvatarColour)">@UiHelpers.Initials(me.DisplayName)</span>
                <span>
                    <span class="cc-usercard-name">@me.DisplayName</span>
                    <span class="cc-usercard-sub">Year @me.StudyYear</span>
                </span>
            </a>
            <button class="cc-nav-item mt-1" @onclick="SwitchUserAsync">
                <span class="cc-nav-icon">↩</span> Switch user
            </button>
        }
        else
        {
            <NavLink class="cc-nav-item" href="login"><span class="cc-nav-icon">→</span> Log in</NavLink>
            <NavLink class="cc-nav-item" href="register"><span class="cc-nav-icon">+</span> Create profile</NavLink>
        }
    </div>
</aside>

@code {
    private int totalUnread;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser.OnChange += HandleUserChanged;     // subscribe
        Chat.Changed += HandleChatChanged;

        await CurrentUser.InitializeAsync();
        await RefreshUnreadAsync();
    }

    private async Task RefreshUnreadAsync()
    {
        totalUnread = CurrentUser.User is null
            ? 0
            : (await Chat.GetUnreadCountsAsync(CurrentUser.User.Id)).Values.Sum();
    }

    private void HandleUserChanged() => Refresh();

    private void HandleChatChanged(ChatChange change)
    {
        if (change.Kind is ChangeKind.Post or ChangeKind.Read) Refresh();
    }

    // The events arrive on another user's thread, so we hop onto this circuit's thread first.
    private void Refresh()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshUnreadAsync();
                StateHasChanged();
            }
            catch (Exception) { /* circuit is closing */ }
        });
    }

    private async Task SwitchUserAsync()
    {
        await CurrentUser.SignOutUser();
        NV.NavigateTo("/login");
    }

    public void Dispose()                               // unsubscribe
    {
        CurrentUser.OnChange -= HandleUserChanged;
        Chat.Changed -= HandleChatChanged;
    }
}
