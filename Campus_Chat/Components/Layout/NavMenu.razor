@inject Campus_Chat.Services.CurrentUserService CurrentUser
@implements IDisposable


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">The Morty Chat</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @if(CurrentUser.User != null){
            <h3 class="text-white">User: @(CurrentUser.User?.DisplayName ?? "User")</h3>}
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/login" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/myThreads" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> My Threads
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/threads" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> All Threads
            </NavLink>
        </div>
        @if (CurrentUser.User is not null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"/profile/{CurrentUser.User.Id}")">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> My profile
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/chats" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Chats
            </NavLink>
        </div>
    </nav>
</div>


@code{

    private string userMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUser.InitializeAsync();
            StateHasChanged();
        }
    }
    
    protected override void OnInitialized()
    {
        CurrentUser.OnChange += HandleCurrentUserChanged;
    }

    private void HandleCurrentUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
    
    public void Dispose()
    {
        CurrentUser.OnChange -= HandleCurrentUserChanged;
    }
}