@inject Campus_Chat.Services.CurrentUserService CurrentUser
@inject Campus_Chat.Services.ChatService Chat
@using Campus_Chat.Models
@implements IDisposable


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">The Morty Chat</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            @if(CurrentUser.User != null){
            <h3 class="text-white">User: @(CurrentUser.User?.DisplayName ?? "User")</h3>}
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/login" Match="NavLinkMatch.All">
                <span class="bi bi-arrow-right-circle-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/myThreads" Match="NavLinkMatch.All">
                <span class="bi bi-hash-nav-menu" aria-hidden="true"></span> My Threads
                @if (totalUnread > 0)
                {
                    <span class="badge bg-danger ms-2">@totalUnread</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/threads" Match="NavLinkMatch.All">
                <span class="bi bi-hash-nav-menu" aria-hidden="true"></span> All Threads
            </NavLink>
        </div>
        
        @if (CurrentUser.User is not null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"/profile/{CurrentUser.User.Id}")">
                    <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span> My Profile
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/people">People</NavLink>
            </div>
        }
        
        
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/chats" Match="NavLinkMatch.All">
                <span class="bi bi-chat-nav-menu" aria-hidden="true"></span> Chats
            </NavLink>
        </div>
    </nav>
</div>


@code{

    private string userMessage = "";
    private int totalUnread;

    protected override void OnInitialized()
    {
        CurrentUser.OnChange += HandleCurrentUserChanged;
        Chat.Changed += HandleChatChanged;
    }

    private async Task RefreshUnreadAsync()
    {
        totalUnread = CurrentUser.User is null
            ? 0
            : (await Chat.GetUnreadCountsAsync(CurrentUser.User.Id)).Values.Sum();
    }

    private void HandleCurrentUserChanged() => Refresh();

    private void HandleChatChanged(ChatChange change)
    {
        if (change.Kind is ChangeKind.Post or ChangeKind.Read) Refresh();
    }

    private void Refresh()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshUnreadAsync();
                StateHasChanged();
            }
            catch (Exception) { /* circuit closing */ }
        });
    }

    public void Dispose()
    {
        CurrentUser.OnChange -= HandleCurrentUserChanged;
        Chat.Changed -= HandleChatChanged;
    }
}