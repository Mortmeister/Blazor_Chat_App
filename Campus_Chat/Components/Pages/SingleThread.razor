@page "/thread/{Id:guid}"
@using Campus_Chat.Models
@inject Campus_Chat.Services.CurrentUserService CurrentUser
@inject Campus_Chat.Services.UserService Users
@inject Campus_Chat.Services.ChatService Chat
@inject IJSRuntime JS


@if (loading)
{
    <p>Loading...</p>
}
else if (summary is null)
{
    <p>This thread doesn't exist.</p>
    <a href="/threads">Back to all threads</a>
}
else
{
    <h1>@summary.Name</h1>
    @if (summary.IsPrivate)
    {
        <span class="badge bg-secondary">private</span>
    }

    @if (CurrentUser.User is null)
    {
        <p class="my-3"><a href="/login">Log in</a> to join this thread and write posts.</p>
    }
    else if (!isMember)
    {
        <div class="my-3">
            @if (summary.IsPrivate)
            {
                <input class="form-control form-control-sm mb-2" style="max-width:15rem"
                       placeholder="Join code" @bind="code" />
            }
            <button class="btn btn-outline-success btn-sm" @onclick="JoinAsync">Join this thread</button>
        </div>
    }

    @if (message is not null)
    {
        <p class="text-danger">@message</p>
    }

    @if (accessDenied)
    {
        <p>This is a private thread. @(CurrentUser.User is null ? "Log in, then" : "Enter the code above and") join to read its posts.</p>
    }



    else if (posts.Count == 0)
    {
        <p>No posts yet!</p>
    }
    else
    {
        @foreach (var post in posts.Where(p => p.ParentPostId is null))
        {
            @RenderPost(post, 0)
        }
    }

    @if (!accessDenied && CurrentUser.User is not null)
    {
        <div class="border rounded p-3 mb-3">
            @if (replyToId is not null)
            {
                <div class="mb-2">
                    Replying to: <em>@ReplyPreview</em>
                    <button class="btn btn-link btn-sm" @onclick="CancelReply">Cancel reply</button>
                </div>
            }

            <textarea class="form-control mb-2" rows="3" placeholder="Write a post"
                  @bind="newText" @bind:event="oninput"></textarea>

            @if (postError is not null)
            {
                <p class="text-danger">@postError</p>
            }

            <button class="btn btn-primary btn-sm" @onclick="SendAsync">Post</button>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ThreadSummary? summary;
    private IReadOnlyList<Post> posts = [];
    private Dictionary<Guid, string> authors = new();
    private bool loading = true;
    private bool isMember;
    private bool accessDenied;
    private string code = "";
    private string? message;
    private Guid? replyToId;

    private void StartReply(Guid postId) => replyToId = postId;
    
    private string newText = "";
    private string? postError;

    private string ReplyPreview
    {
        get
        {
            var target = posts.FirstOrDefault(p => p.Id == replyToId);
            if (target is null) return "";
            return target.Text.Length > 60 ? target.Text[..60] + "..." : target.Text;
        }
    }

    private void CancelReply() => replyToId = null;
    
    // Draws a post, then its replies, then their replies, and so on.
    private RenderFragment RenderPost(Post post, int depth) => __builder =>
    {
        <div class="@(depth is > 0 and < 4 ? "ms-4" : "")">
            <PostComponent Post="post"
                           AuthorName="@AuthorName(post.AuthorId)"
                           CanDelete="@(CurrentUser.User is not null && post.AuthorId == CurrentUser.User.Id)"
                           CanReply="@(CurrentUser.User is not null)"
                           OnReply="StartReply" 
                           OnDelete="HandleDelete"
                           />
            

            @foreach (var reply in posts.Where(r => r.ParentPostId == post.Id))
            {
                @RenderPost(reply, depth + 1)
            }
        </div>
    };

    private async Task SendAsync()
    {
        postError = null;
        try
        {
            await Chat.AddPostAsync(CurrentUser.User!.Id, Id, newText, replyToId);
            newText = "";
            replyToId = null;
            posts = await Chat.GetPostsAsync(CurrentUser.User.Id, Id);   // reload posts only, no full-page flicker
        }
        catch (Exception ex) when (ex is ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            postError = ex.Message;   // these messages are written for users to read
        }
    }
    
    protected override async Task OnParametersSetAsync()
    {
        await CurrentUser.InitializeAsync();   // no redirect: visitors may read public threads
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        accessDenied = false;
        message = null;
        posts = [];

        // Guid.Empty means "nobody". The service then treats the caller as a plain visitor.
        var me = CurrentUser.User?.Id ?? Guid.Empty;
        summary = await Chat.GetSingleThreadSummaryAsync(Id);

        if (summary is not null)
        {
            if (CurrentUser.User is not null)
            {
                var mine = await Chat.GetThreadsForUserAsync(me, me);
                isMember = mine.Any(t => t.Id == Id);
            }
            else
            {
                isMember = false;
            }

            try
            {
                posts = await Chat.GetPostsAsync(me, Id);
                authors = (await Users.GetAllAsync()).ToDictionary(u => u.Id, u => u.DisplayName);
            }
            catch (UnauthorizedAccessException)
            {
                accessDenied = true;
            }
        }

        loading = false;
    }

    private async Task JoinAsync()
    {
        try
        {
            await Chat.JoinThreadAsync(CurrentUser.User!.Id, Id, code);
            code = "";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or KeyNotFoundException)
        {
            message = ex.Message;
        }
    }
    
    private async Task HandleDelete(Guid postId)
    {
        postError = null;
        
        var text = "Delete this post?";

        if (!await JS.InvokeAsync<bool>("confirm", text)) return;
        
        
        try
        {
            await Chat.DeletePostAsync(CurrentUser.User!.Id, Id, postId);
            if (replyToId == postId) replyToId = null;   // don't keep replying to something that's gone
            posts = await Chat.GetPostsAsync(CurrentUser.User.Id, Id);
        }
        catch (Exception ex) when (ex is KeyNotFoundException or UnauthorizedAccessException)
        {
            postError = ex.Message;
        }
    }

    private string AuthorName(Guid authorId)
        => authors.TryGetValue(authorId, out var name) ? name : "Unknown user";
}