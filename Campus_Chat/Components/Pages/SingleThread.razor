@page "/thread/{Id:guid}"
@using Campus_Chat.Models
@inject Campus_Chat.Services.CurrentUserService CurrentUser
@inject Campus_Chat.Services.UserService Users
@inject Campus_Chat.Services.ChatService Chat
@inject IJSRuntime JS
@implements IDisposable

<div class="cc-thread-page">
    @if (loading)
    {
        <div class="cc-thread-loading">
            <div class="spinner-border" role="status"></div>
            <p>Loading conversation...</p>
        </div>
    }
    else if (summary is null)
    {
        <div class="cc-thread-empty">
            <h2>Thread not found</h2>
            <p>This conversation doesn't exist or may have been removed.</p>
            <a href="/threads" class="cc-back-link">← Back to threads</a>
        </div>
    }
    else
    {
        <header class="cc-thread-header">
            <div class="cc-thread-header-left">
                <a href="/threads" class="cc-thread-back">←</a>
                <div>
                    <div class="cc-thread-heading">
                        <h1>@summary.Name</h1>

                        @if (summary.IsPrivate)
                        {
                            <span class="cc-private-badge">🔒 Private</span>
                        }
                    </div>
                    <p class="cc-thread-subtitle">
                        <span class="cc-online-dot"></span>
                        @summary.MembershipCount @(summary.MembershipCount == 1 ? "member" : "members")
                        <span>·</span>
                        @(summary.IsPrivate ? "Private thread" : "Public thread")
                    </p>
                    
                    
                </div>
            </div>
        </header>

        <div class="cc-thread-content">

            @if (CurrentUser.User is null)
            {
                <div class="cc-access-card">
                    <div class="cc-access-icon">👋</div>
                    <h2>Join the conversation</h2>
                    <p>Log in to become part of this community and share your thoughts.</p>
                    <a href="/login" class="btn cc-primary-btn">Log in</a>
                </div>
            }
            else if (!isMember)
            {
                <div class="cc-access-card">
                    <div class="cc-access-icon">💬</div>
                    <h2>Join this thread</h2>
                    <p>Become a member to participate in this conversation.</p>

                    @if (summary.IsPrivate)
                    {
                        <input class="form-control cc-join-input"
                               placeholder="Enter your private join code"
                               @bind="code" />
                    }

                    <button class="btn cc-primary-btn" @onclick="JoinAsync">
                        Join conversation
                    </button>
                </div>
            }

            @if (message is not null)
            {
                <div class="alert alert-danger">@message</div>
            }

            @if (accessDenied)
            {
                <div class="cc-access-card">
                    <div class="cc-access-icon">🔒</div>
                    <h2>This is a private conversation</h2>
                    <p>Join this thread to see its messages.</p>
                </div>
            }
            else if (posts.Count == 0)
            {
                <div class="cc-welcome-card">
                    <div class="cc-welcome-icon">✦</div>
                    <span class="cc-welcome-label">WELCOME TO THE THREAD</span>
                    <h2>It's quiet in here...</h2>
                    <p>Be the first to start the conversation. Share an idea, ask a question or just say hello!</p>
                </div>
            }
            else
            {
                <div class="cc-welcome-card">
                    <span class="cc-welcome-label">WELCOME TO THE THREAD</span>
                    <h2>@summary.Name</h2>
                    <p>This is the beginning of the conversation. Jump in and share your thoughts!</p>
                </div>

                <div class="cc-today-divider">
                    <span>CONVERSATION</span>
                </div>

                <div class="cc-post-list">
                    @foreach (var post in posts.Where(p => p.ParentPostId is null))
                    {
                        @RenderPost(post, 0)
                    }
                </div>
            }

            @if (!accessDenied && CurrentUser.User is not null && isMember)
            {
                <div class="cc-composer-wrapper">
                    @if (replyToId is not null)
                    {
                        <div class="cc-replying">
                            <span>↳ Replying to: <strong>@ReplyPreview</strong></span>
                            <button @onclick="CancelReply">Cancel</button>
                        </div>
                    }

                    <div class="cc-composer">
                        <textarea class="cc-composer-input"
                                  rows="2"
                                  placeholder="Share something with the thread..."
                                  @bind="newText"
                                  @bind:event="oninput"></textarea>

                        <div class="cc-composer-bottom">
                            <span class="cc-composer-hint">Be kind. Keep the conversation going.</span>
                            <button class="btn cc-send-btn"
                                    @onclick="SendAsync"
                                    disabled="@string.IsNullOrWhiteSpace(newText)">
                                Send message <span>↑</span>
                            </button>
                        </div>
                    </div>

                    @if (postError is not null)
                    {
                        <p class="text-danger small mt-2">@postError</p>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ThreadSummary? summary;
    private IReadOnlyList<Post> posts = [];
    private Dictionary<Guid, User> authors = new();

    private bool loading = true;
    private bool isMember;
    private bool accessDenied;

    private string code = "";
    private string? message;
    private Guid? replyToId;

    private string newText = "";
    private string? postError;

    private void StartReply(Guid postId) => replyToId = postId;

    private string ReplyPreview
    {
        get
        {
            var target = posts.FirstOrDefault(p => p.Id == replyToId);
            if (target is null) return "";

            return target.Text.Length > 60
                ? target.Text[..60] + "..."
                : target.Text;
        }
    }

    private void CancelReply() => replyToId = null;

    private RenderFragment RenderPost(Post post, int depth) => __builder =>
    {
        <div class="cc-post-wrapper @(depth > 0 ? "cc-post-reply" : "")"
             style="--reply-depth:@Math.Min(depth, 4)">

            <PostComponent Post="post"
                           AuthorName="@AuthorName(post.AuthorId)"
                           CanDelete="@(CurrentUser.User is not null && post.AuthorId == CurrentUser.User.Id)"
                           CanReply="@(CurrentUser.User is not null && isMember)"
                           OnReply="StartReply"
                           OnDelete="HandleDelete"
                           AvatarColour="@AuthorColour(post.AuthorId)" />

            @foreach (var reply in posts.Where(r => r.ParentPostId == post.Id))
            {
                @RenderPost(reply, depth + 1)
            }
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        await CurrentUser.InitializeAsync();
        await LoadAsync();
    }

    protected override void OnInitialized()
    {
        Chat.Changed += OnChanged;
    }

    private async Task LoadAsync()
    {
        loading = true;
        accessDenied = false;
        message = null;
        posts = [];

        var me = CurrentUser.User?.Id ?? Guid.Empty;

        summary = await Chat.GetSingleThreadSummaryAsync(Id);

        if (summary is not null)
        {
            if (CurrentUser.User is not null)
            {
                var mine = await Chat.GetThreadsForUserAsync(me, me);
                isMember = mine.Any(t => t.Id == Id);
            }
            else
            {
                isMember = false;
            }

            try
            {
                posts = await Chat.GetPostsAsync(me, Id);
                authors = (await Users.GetAllAsync()).ToDictionary(u => u.Id);
            }
            catch (UnauthorizedAccessException)
            {
                accessDenied = true;
            }

            if (CurrentUser.User is not null && isMember && !accessDenied)
            {
                await Chat.MarkThreadReadAsync(me, Id);
            }
        }

        loading = false;
    }

    private void OnChanged(ChatChange change)
    {
        if (change.Kind != ChangeKind.Post || change.ScopeId != Id)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await ReloadPostsAsync();
                StateHasChanged();
            }
            catch (Exception)
            {
                // Circuit is closing.
            }
        });
    }

    private async Task ReloadPostsAsync()
    {
        var me = CurrentUser.User?.Id ?? Guid.Empty;

        try
        {
            posts = await Chat.GetPostsAsync(me, Id);
        }
        catch (UnauthorizedAccessException)
        {
            return;
        }

        if (CurrentUser.User is not null && isMember)
        {
            await Chat.MarkThreadReadAsync(me, Id);
        }
    }

    private async Task JoinAsync()
    {
        try
        {
            await Chat.JoinThreadAsync(CurrentUser.User!.Id, Id, code);
            code = "";
            await LoadAsync();
        }
        catch (Exception ex) when (
            ex is UnauthorizedAccessException or KeyNotFoundException)
        {
            message = ex.Message;
        }
    }

    private async Task SendAsync()
    {
        postError = null;

        if (string.IsNullOrWhiteSpace(newText))
            return;

        try
        {
            await Chat.AddPostAsync(
                CurrentUser.User!.Id,
                Id,
                newText,
                replyToId);

            newText = "";
            replyToId = null;

            posts = await Chat.GetPostsAsync(CurrentUser.User.Id, Id);
        }
        catch (Exception ex) when (
            ex is ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            postError = ex.Message;
        }
    }

    private async Task HandleDelete(Guid postId)
    {
        postError = null;

        if (!await JS.InvokeAsync<bool>("confirm", "Delete this post?"))
            return;

        try
        {
            await Chat.DeletePostAsync(CurrentUser.User!.Id, Id, postId);

            if (replyToId == postId)
                replyToId = null;

            posts = await Chat.GetPostsAsync(CurrentUser.User.Id, Id);
        }
        catch (Exception ex) when (
            ex is KeyNotFoundException or UnauthorizedAccessException)
        {
            postError = ex.Message;
        }
    }

    private string AuthorName(Guid id) =>
        authors.TryGetValue(id, out var user)
            ? user.DisplayName
            : "Unknown user";

    private string? AuthorColour(Guid id) =>
        authors.TryGetValue(id, out var user)
            ? user.AvatarColour
            : null;

    public void Dispose()
    {
        Chat.Changed -= OnChanged;
    }
}