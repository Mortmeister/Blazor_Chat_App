@page "/test"
@inject Campus_Chat.Services.UserService Users
@inject Campus_Chat.Services.ChatService Threads
@rendermode InteractiveServer

<h3>System- og profiltesting</h3>



<div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ccc; background-color: #f9f9f9;">
    <h4>Kjør testtilfeller:</h4>
    
    <div class="d-flex flex-row gap-5">
        <div style="margin-bottom: 10px;">
            <button class="btn btn-success" @onclick="RunTestCase2A">Join a thread</button>
        </div>
        <div style="margin-bottom: 10px;">
            <input
                type="text"
                @bind = "threadIdInput"
                placeholder="Enter thread ID"
                class="form-control" />
        </div>
        <div style="margin-bottom: 10px;">
            <input
                type="password"
                @bind = "threadCodeInput"
                placeholder="Enter thread Code"
                class="form-control" />
        </div>
    </div>
    <div class="d-flex flex-row gap-5">
        <div style="margin-bottom: 10px;">
            <button class="btn btn-danger" @onclick="RunTestCase2B">Leave a thread</button>
        </div>
        <div style="margin-bottom: 10px;">
            <input
                type="text"
                @bind = "threadIdInput"
                placeholder="Enter thread ID"
                class="form-control" />
        </div>
    </div>
</div>

<!-- Viser resultatet eller feilmeldingen fra testen umiddelbart -->
@if (!string.IsNullOrEmpty(testResultMessage))
{
    <div style="padding: 10px; margin-bottom: 20px; border-radius: 4px; background-color: #e2f0d9; color: #385723; border: 1px solid #c5e0b4;">
        <strong>Resultat:</strong> @testResultMessage
    </div>
}


@if (!string.IsNullOrEmpty(testErrorMessage))
{
    <div style="padding: 10px; margin-bottom: 20px; border-radius: 4px; background-color: #fce4d6; color: #c65911; border: 1px solid #f8cbad;">
        <strong>Feilmelding fanget:</strong> @testErrorMessage
    </div>
}

<hr />

<h4>Brukerliste:</h4>
@foreach (var u in all)
{
    <p>ID: @u.Id | <strong>@u.DisplayName</strong> (År: @u.StudyYear)</p>
}
<h4>Threads:</h4>

@foreach (var thread in allThreads)
{
    <p>
        ID: @thread.Id |
        <strong>@thread.Name</strong>
        <p>Membership Count : {@thread.MembershipCount}</p>
        (Private: @thread.IsPrivate)
    </p>
}

@code {
    private IReadOnlyList<Campus_Chat.Models.User> all = [];
    private IReadOnlyList<Campus_Chat.Models.ThreadSummary> allThreads = [];
    
    
    private string testResultMessage = "";
    private string testErrorMessage = "";
    
    private string threadIdInput = "";
    private string threadCodeInput = "";

    
    private Guid actualTestUserId = Guid.Parse("b3cc96f1-6034-40cd-90c3-53cfe2002d6b"); 
    private Guid actualTestUserId2 = Guid.Parse("f6fa421a-1910-49eb-9174-bd8697a6e15c"); 
    
    
    private Guid actualThreadId = Guid.Parse("62e56492-c633-474b-9655-66f0ef2d1a4b"); 

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
        await RefreshThreads();
    }

    private void ClearStatus()
    {
        testResultMessage = "";
        testErrorMessage = "";
    }

    private async Task RefreshList()
    {
        all = await Users.GetAllAsync();
    }
    
    private async Task RefreshThreads()
    {
        allThreads = await Threads.GetThreadSummariesAsync();
    }
    
    /*Test the bugs are gone using your throwaway /test page.
     Temporarily call the store, or the service once it exists, and check:
    Add two users and two threads. User A joins both. A’s membership list has 2 items, and B’s has 0.
    Add 3 posts across 2 threads. GetPostsAsync for thread 1 returns only thread 1’s posts, oldest first.
    Delete one post by its ID. The other two are still there.*/
    private async Task RunTestCase2A()
    {
        if (!Guid.TryParse(threadIdInput, out Guid threadId))
        {
            testErrorMessage = "Please enter a valid thread ID.";
            return;
        }
        
        try
        {
            await Threads.JoinThreadAsync(
                callerId: actualTestUserId, 
                threadId: threadId,
                code: threadCodeInput
            );
            testResultMessage = "Join operation completed successfully.";
            await RefreshThreads();
        }
        
        catch (Exception ex)
        {
            testErrorMessage = ex.Message;
        }
    }
    private async Task RunTestCase2B()
    {
        if (!Guid.TryParse(threadIdInput, out Guid threadId))
        {
            testErrorMessage = "Please enter a valid thread ID.";
            return;
        }
        
        try
        {
            await Threads.LeaveThreadAsync(
                callerId: actualTestUserId, 
                threadId: threadId
            );
            testResultMessage = "Thread left successfully.";
            await RefreshThreads();
        }
        
        catch (Exception ex)
        {
            testErrorMessage = ex.Message;
        }
    }

    
    
}



