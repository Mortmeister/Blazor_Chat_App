@page "/people"
@using Campus_Chat.Models
@inject Campus_Chat.Services.UserService Users
@inject Campus_Chat.Services.CurrentUserService CurrentUser

<h1>People</h1>

<input type="search" class="form-control mb-3" style="max-width:25rem"
       placeholder="Search by name"
       @bind="searchText" @bind:event="oninput" />

@if (Visible.Count == 0)
{
    <p>No people match "@searchText".</p>
}
else
{
    <div class="list-group" style="max-width:25rem">
        @foreach (var u in Visible)
        {
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="/profile/@u.Id">
                <span class="rounded-circle d-inline-block"
                      style="width:32px;height:32px;background-color:@(string.IsNullOrWhiteSpace(u.AvatarColour) ? "#6c757d" : u.AvatarColour)"></span>
                <span>
                    <strong>@u.DisplayName</strong>
                    <small class="text-muted d-block">Year @u.StudyYear</small>
                </span>
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<User> all = [];
    private string searchText = "";

    private List<User> Visible =>
        all.Where(u => string.IsNullOrWhiteSpace(searchText) ||
                       u.DisplayName.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(u => u.DisplayName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!await CurrentUser.EnsureSignedInAsync()) return;
        all = await Users.GetAllAsync();
    }
}